{
  "name": "violettheme",
  "displayName": "Violet Theme",
  "publisher": "FilipeAbdo",
  "icon": "images/icon.png",
  "description": "VS Code Color Theme Violet [Dark]",
  "version": "0.2.2",
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "test": "node --test scripts/extension.test.cjs scripts/build-theme.test.cjs scripts/watch-theme.test.cjs scripts/palette.test.cjs scripts/release.test.cjs",
    "release": "node scripts/release.cjs",
    "build": "node scripts/build-theme.cjs",
    "watch": "node --watch --watch-path=src --watch-path=scripts --watch-path=images/icon-source.svg --watch-path=package.json scripts/build-theme.cjs --development",
    "watch:decorations:agent": "node scripts/watch-decorations-agent.cjs",
    "toggle:env": "node scripts/dev-target.cjs",
    "install:local": "node scripts/install-local.cjs",
    "install:local:release": "node scripts/install-local.cjs --release",
    "install:local:release:minor": "node scripts/install-local.cjs --release --significant",
    "install:local:release:major": "node scripts/install-local.cjs --release --major",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "tinycolor2": "^1.6.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "violetTheme.previewPalette",
        "title": "Violet Theme: Preview Color Palette"
      },
      {
        "command": "violetTheme.installAndReload",
        "title": "Violet Theme: Install Locally and Reload Window"
      },
      {
        "command": "violetTheme.installReleaseAndReload",
        "title": "Violet Theme: Install Release Locally and Reload Window"
      },
      {
        "command": "violetTheme.chooseReleaseAndReload",
        "title": "Violet Theme: Choose Release Impact, Install and Reload"
      }
    ],
    "keybindings": [
      {
        "command": "violetTheme.installAndReload",
        "key": "ctrl+k ctrl+i",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "violetTheme.installReleaseAndReload",
        "key": "ctrl+k ctrl+shift+i",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "violetTheme.chooseReleaseAndReload",
        "key": "ctrl+k ctrl+/",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Violet Theme",
      "properties": {
        "violetTheme.decorateAttributeAccessIssues": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color the text ranges of Pylance reportAttributeAccessIssue diagnostics while VS Code Violet Theme is selected."
        },
        "violetTheme.decorateUnusedCode": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Apply the configured font style and Violet unused-code color or opacity to unnecessary-code diagnostics while VS Code Violet Theme is selected."
        },
        "violetTheme.unusedFontStyle": {
          "type": "string",
          "pattern": "^(?:normal|(?!(?:.*\\bitalic\\b.*\\boblique\\b|.*\\boblique\\b.*\\bitalic\\b))(?!.*\\b(?:solid|wavy|dotted|dashed|double)\\b.*\\b(?:solid|wavy|dotted|dashed|double)\\b)(?:(?=.*\\b(?:underline|strikethrough|line-through)\\b)|(?!.+#))(?:italic|oblique|bold|underline(?: (?:solid|wavy|dotted|dashed|double))?|strikethrough|line-through)(?: (?:italic|oblique|bold|underline(?: (?:solid|wavy|dotted|dashed|double))?|strikethrough|line-through))*(?: #[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?)?|)$",
          "default": "italic underline wavy #fdbe01",
          "scope": "window",
          "description": "Space-separated styles: italic, bold, underline, strikethrough (or line-through). Follow underline with solid, wavy, dotted, dashed, or double, e.g. italic underline wavy. Also supports oblique instead of italic. Use normal or an empty string for no added style. The underline modifier also affects a combined strikethrough.",
          "patternErrorMessage": "Use supported space-separated font styles. Put one modifier immediately after underline. An optional trailing #RRGGBB or #RRGGBBAA color requires underline or strikethrough. Do not combine italic with oblique."
        }
      }
    },
    "colors": [
      {
        "id": "violetTheme.attributeAccessForeground",
        "description": "Text color for Pylance attribute-access diagnostic ranges.",
        "defaults": {
          "dark": "editorError.foreground",
          "light": "editorError.foreground",
          "highContrast": "editorError.foreground",
          "highContrastLight": "editorError.foreground"
        }
      },
      {
        "id": "violetTheme.unusedForeground",
        "description": "Foreground color for Violet Theme unnecessary-code decorations.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      }
    ],
    "themes": [
      {
        "label": "VS Code Violet Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/VS Code Violet Theme-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.experimental.modernUI": true,
      "workbench.experimental.modernUIEditorTabStyle": "pill",
      "python.languageServer": "Pylance",
      "workbench.colorCustomizations": {
        "[VS Code Violet Theme]": {
          "tab.inactiveForeground": "#e3f8f8bf",
          "tab.unfocusedInactiveForeground": "#4c8f95bf"
        }
      }
    }
  }
}
